{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "packaging",
    "scripts/bench",
    "vitest.config.ts",
    "vitest.bench.config.ts"
  ]
}
