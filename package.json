{
  "name": "@portone-io/docx-editor",
  "version": "0.1.0",
  "description": "A React DOCX editor that reads and writes OOXML directly.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portone-io/docx-editor.git"
  },
  "homepage": "https://github.com/portone-io/docx-editor#readme",
  "bugs": {
    "url": "https://github.com/portone-io/docx-editor/issues"
  },
  "keywords": [
    "docx",
    "editor",
    "ooxml",
    "prosemirror",
    "react"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./commands": "./src/editor/commands/index.ts",
    "./table": "./src/table/index.ts",
    "./styles.css": "./src/styles/editor.css"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "./commands": {
        "types": "./dist/editor/commands/index.d.ts",
        "default": "./dist/editor/commands/index.js"
      },
      "./table": {
        "types": "./dist/table/index.d.ts",
        "default": "./dist/table/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "assets",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "dev": "vite --config playground/vite.config.ts --open",
    "build:playground": "vite build --config playground/vite.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p playground",
    "lint": "pnpm biome check . --diagnostic-level=error",
    "test": "vitest run",
    "test:package": "vitest run --dir packaging --no-file-parallelism",
    "verify:package": "node scripts/verify-package.mjs",
    "spec": "node scripts/index-ooxml-spec.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^1.16.0"
  },
  "peerDependencies": {
    "prosemirror-commands": "^1.5.2",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.19.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.6",
    "react": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.7.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "prosemirror-commands": "^1.5.2",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.19.4",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
